# Gemini API — 小红书 Topic Manager（Guide/0）
#
# 用法：
#   cp .env.example .env
#   编辑 .env，填入 GEMINI_API_KEY（.env 已在 .gitignore，不会提交）
#
# Python 启动时自动 load_dotenv() 读取本文件（见 kernels/xiaohongshu/config/gemini_config.py）
# Agent 在 Terminal 跑 verify 脚本即可自主验收，无需在聊天里粘贴 Key。
#
# 获取 Key：https://aistudio.google.com/apikey

GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY
GEMINI_MODEL=gemini-3.5-flash
